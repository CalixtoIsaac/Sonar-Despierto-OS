# Configuración de DESARROLLO: copia este archivo como .env (en Windows: copy .env.example .env).
# El paquete portátil usa {carpeta de datos}\config.env, que se crea solo en el primer arranque.

# development | production   (en production no hay rutas de prueba y se cachean los archivos)
APP_ENV=development

# Puerto del sistema (http://localhost:PORT). Si está ocupado se prueban los 20 siguientes.
PORT=8765
# true = otras PCs de la oficina entran con http://IP-DE-ESTA-PC:PORT (solo en la red privada)
LAN_MODE=false
# false = no abrir el navegador al arrancar (npm run dev ya lo desactiva)
OPEN_BROWSER=true

# Carpeta de datos (BD, logs, respaldos). Vacía = <repo>\.data. NUNCA dentro de OneDrive/Dropbox
# en producción. El repositorio está en OneDrive: para desarrollo diario puedes usar, por ejemplo,
# SD_DATA_DIR=C:\SonarDespiertoDatos
SD_DATA_DIR=

# Clave para firmar las sesiones (mínimo 32 caracteres). Vacía = se genera y guarda en
# {carpeta de datos}\secret.key (así la sesión no se cierra al reiniciar).
JWT_SECRET=
# Horas que dura una sesión
SESSION_HOURS=8

# Administrador inicial (solo se crea si la BD no tiene usuarios).
FIRST_ADMIN_EMAIL=admin@sonardespierto.org
# Vacía = contraseña aleatoria escrita en {carpeta de datos}\CREDENCIALES_INICIALES.txt
FIRST_ADMIN_PASSWORD=

# Intentos fallidos de inicio de sesión permitidos por equipo y correo en la ventana de minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

MAX_UPLOAD_MB=5

# Registro de cuentas del personal (ADR-0008). false = solo el administrador crea cuentas.
REGISTRATION_ENABLED=true
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_MINUTES=60
