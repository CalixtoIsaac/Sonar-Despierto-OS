# ------------------------------------------------------------------
#  Configuración de Soñar Despierto
#  Guarda los cambios y vuelve a abrir el programa para aplicarlos.
# ------------------------------------------------------------------

# Puerto donde se abre el sistema (http://localhost:PUERTO)
PORT=8765

# false = solo esta computadora puede entrar al sistema.
# true  = otras computadoras de la oficina pueden entrar con http://IP-DE-ESTA-PC:PUERTO
#         (Windows pedirá permiso en el Firewall: marca "Redes privadas").
LAN_MODE=false

# true  = el personal puede solicitar su cuenta en la pantalla de inicio de sesión;
#         un administrador debe aprobarla (menú Usuarios → Solicitudes).
# false = solo el administrador crea cuentas.
REGISTRATION_ENABLED=true

# Respaldo automático: uno al día mientras el programa esté abierto (en la carpeta backups).
BACKUP_AUTO=true
# Cuántos respaldos automáticos se conservan (los más viejos se borran solos).
BACKUP_KEEP=14
# Carpeta donde se guarda ADEMÁS una copia de cada respaldo: otra unidad, una USB que siempre
# esté conectada o una carpeta sincronizada de la nube. Ejemplo: BACKUP_COPY_DIR=D:\Respaldos Soñar
# Vacía = sin copia extra.
BACKUP_COPY_DIR=

# Solo si aparece "Dirección no permitida": nombres extra para entrar, separados por comas.
ALLOWED_HOSTS=
